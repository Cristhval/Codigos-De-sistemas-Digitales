// =======================
// CONFIGURACION DE PINES
// =======================
const int LED_PINS[] = {2, 3, 4, 5, 6, 7};
const int NUM_LEDS = 6;
const int BUTTON_PIN = 8;

// =======================
// VARIABLES DE CONTROL
// =======================
int patronActual = -1; // iniciar sin patron
bool estadoAnterior = LOW;

// =======================
// SETUP
// =======================
void setup() {
  for (int i = 0; i < NUM_LEDS; i++) {
    pinMode(LED_PINS[i], OUTPUT);
  }

  pinMode(BUTTON_PIN, INPUT); // pull-down externo

  apagarTodos(); // asegurar inicio apagado
}

// =======================
// LOOP PRINCIPAL
// =======================
void loop() {
  leerBoton();

  if (patronActual == -1) {
    return; // no ejecuta nada hasta presionar
  }

  switch (patronActual) {
    case 0:
      patronSecuencia();
      break;
    case 1:
      patronPersecucion();
      break;
    case 2:
      patronParpadeo();
      break;
    case 3:
      patronAleatorio();
      break;
    case 4:
      patronOnda();
      break;
  }
}

// =======================
// FUNCIONES
// =======================

void leerBoton() {
  bool estadoActual = digitalRead(BUTTON_PIN);

  // Detecta cuando se PRESIONA (LOW → HIGH)
  if (estadoActual == HIGH && estadoAnterior == LOW) {
    patronActual++;

    if (patronActual > 4) {
      patronActual = 0;
    }

    delay(200); // debounce
  }

  estadoAnterior = estadoActual;
}

// =======================
// PATRONES
// =======================

void patronSecuencia() {
  for (int i = 0; i < NUM_LEDS; i++) {
    encenderSolo(i);
    delay(150);
  }
}

void patronPersecucion() {
  for (int i = 0; i < NUM_LEDS; i++) {
    encenderSolo(i);
    delay(100);
  }

  for (int i = NUM_LEDS - 2; i > 0; i--) {
    encenderSolo(i);
    delay(100);
  }
}

void patronParpadeo() {
  encenderTodos();
  delay(300);
  apagarTodos();
  delay(300);
}

void patronAleatorio() {
  int led = random(0, NUM_LEDS);
  encenderSolo(led);
  delay(200);
}

void patronOnda() {
  for (int i = 0; i < NUM_LEDS; i++) {
    encenderSolo(i);
    delay(80);
  }

  for (int i = NUM_LEDS - 1; i >= 0; i--) {
    encenderSolo(i);
    delay(80);
  }
}

// =======================
// AUXILIARES
// =======================

void encenderSolo(int index) {
  apagarTodos();
  digitalWrite(LED_PINS[index], HIGH);
}

void encenderTodos() {
  for (int i = 0; i < NUM_LEDS; i++) {
    digitalWrite(LED_PINS[i], HIGH);
  }
}

void apagarTodos() {
  for (int i = 0; i < NUM_LEDS; i++) {
    digitalWrite(LED_PINS[i], LOW);
  }
}
